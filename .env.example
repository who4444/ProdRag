# Local-dev defaults: PRODRAG_QDRANT_URL=http://localhost:6333,
# PRODRAG_REDIS_URL=redis://localhost:6379, PRODRAG_MINIO_ENDPOINT=localhost:9000.
# docker-compose overrides these with the internal service names, so don't set
# them here unless you want to force non-default values in both environments.

# Answering LLM (DeepSeek, OpenAI-compatible; chat only — no vision/embeddings).
# Leave PRODRAG_CHAT_BASE_URL empty to use OpenAI instead.
PRODRAG_CHAT_API_KEY=sk-...
PRODRAG_CHAT_BASE_URL=https://api.deepseek.com
PRODRAG_CHAT_MODEL=deepseek-v4-flash
PRODRAG_CHAT_SUPPORTS_IMAGES=false

# For a vision-capable chat model (e.g. gpt-4o): PRODRAG_CHAT_BASE_URL=
# PRODRAG_CHAT_SUPPORTS_IMAGES=true PRODRAG_CHAT_MODEL=gpt-4o
# PRODRAG_OPENAI_API_KEY=sk-...

PRODRAG_API_TOKEN=change-me

# GPU embedding services on Modal (deploy/modal/). Unset a URL to use the
# local/fallback path instead.
# bge-m3 text embeddings (1024 dims) — set PRODRAG_EMBEDDING_DIM to match the model.
PRODRAG_EMBED_SERVICE_URL=https://<workspace>--prodrag-embed-textembedder-embed.modal.run
PRODRAG_EMBED_SERVICE_TOKEN=
# CLIP vision embeddings (512 dims).
PRODRAG_CLIP_SERVICE_URL=https://<workspace>--prodrag-clip-clipembedder-embed.modal.run
PRODRAG_CLIP_SERVICE_TOKEN=

# Optional tuning
# PRODRAG_CHUNK_SIZE=800
# PRODRAG_CHUNK_OVERLAP=100
# PRODRAG_PAGE_DPI=150
# PRODRAG_VISION_EMBEDDING_MODEL=ViT-B-32
# PRODRAG_CHAT_MODEL=gpt-4o
