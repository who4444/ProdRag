# Local-dev defaults: PRODRAG_QDRANT_URL=http://localhost:6333,
# PRODRAG_REDIS_URL=redis://localhost:6379.
# docker-compose overrides the QDRANT/REDIS URLs with internal service names.

# Object storage: Supabase Storage native REST API. Project URL + secret API
# key from Supabase dashboard > Project Settings > API. Create the bucket there.
PRODRAG_SUPABASE_URL=https://<project-ref>.supabase.co
PRODRAG_SUPABASE_SECRET_KEY=<secret api key>
PRODRAG_STORAGE_BUCKET=prodrag-assets
# Relational store (Supabase Postgres). From Project Settings > Database >
# Connection string. Apply schema.sql (SQL editor or psql) before running.
# PRODRAG_DATABASE_URL=postgresql://postgres.<ref>.<host>:5432/postgres

# Answering LLM (DeepSeek, OpenAI-compatible; chat only — no vision/embeddings).
# Leave PRODRAG_CHAT_BASE_URL empty to use OpenAI instead.
PRODRAG_CHAT_API_KEY=sk-...
PRODRAG_CHAT_BASE_URL=https://api.deepseek.com
PRODRAG_CHAT_MODEL=deepseek-v4-flash
PRODRAG_CHAT_SUPPORTS_IMAGES=false

# For a vision-capable chat model (e.g. gpt-4o): PRODRAG_CHAT_BASE_URL=
# PRODRAG_CHAT_SUPPORTS_IMAGES=true PRODRAG_CHAT_MODEL=gpt-4o
# PRODRAG_OPENAI_API_KEY=sk-...

PRODRAG_API_TOKEN=change-me

# GPU embedding services on Modal (deploy/modal/). Unset a URL to use the
# local/fallback path instead.
# bge-m3 text embeddings (1024 dims) — set PRODRAG_EMBEDDING_DIM to match the model.
PRODRAG_EMBED_SERVICE_URL=https://<workspace>--prodrag-embed-textembedder-embed.modal.run
PRODRAG_EMBED_SERVICE_TOKEN=
# CLIP vision embeddings (512 dims).
PRODRAG_CLIP_SERVICE_URL=https://<workspace>--prodrag-clip-clipembedder-embed.modal.run
PRODRAG_CLIP_SERVICE_TOKEN=

# Optional tuning
# PRODRAG_CHUNK_SIZE=800
# PRODRAG_CHUNK_OVERLAP=100
# PRODRAG_PAGE_DPI=150
# PRODRAG_VISION_EMBEDDING_MODEL=ViT-B-32
# PRODRAG_CHAT_MODEL=gpt-4o

# Research agent + memory
# PRODRAG_AGENT_MODEL=deepseek-v4-flash
# PRODRAG_AGENT_MAX_STEPS=12
# PRODRAG_MEMORY_COLLECTION=episodes
# PRODRAG_MEMORY_TOP_K=5
# PRODRAG_MEMORY_TTL_S=86400

# Hybrid retrieval: BM25 (Qdrant sparse vector) fused with dense via RRF.
# Optional cross-encoder reranker on Modal (deploy/modal/rerank_service.py);
# results keep RRF order when the URL is unset.
# PRODRAG_RETRIEVAL_HYBRID_K=12
# PRODRAG_RERANK_SERVICE_URL=https://<workspace>--prodrag-rerank-reranker-rerank.modal.run
# PRODRAG_RERANK_SERVICE_TOKEN=
# PRODRAG_RERANK_MODEL=BAAI/bge-reranker-base

# Web search tools (optional — RAG-only when all unset)
# PRODRAG_TAVILY_API_KEY=tvly-...
# PRODRAG_SERPER_API_KEY=...
# PRODRAG_SEARCH_SERVICE_URL=https://<your-search-proxy>/search
# PRODRAG_SEARCH_SERVICE_TOKEN=
# PRODRAG_SEARCH_MAX_RESULTS=5
